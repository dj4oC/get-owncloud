{
  "apiVersion": "get.owncloud.com/v1alpha1",
  "purpose": "production",
  "target": { "runtime": "docker", "manager": "direct" },
  "workload": {
    "registeredUsers": 100,
    "storedDataGiB": 500,
    "annualGrowthPercent": 20
  },
  "identity": {
    "mode": "external-oidc",
    "issuer": "https://id.acme-corp.net/realms/owncloud",
    "clientId": "web",
    "ldapUri": "ldaps://directory.acme-corp.net:636",
    "ldapBindDn": "uid=ocis,ou=system,dc=acme-corp,dc=net",
    "ldapUserBaseDn": "ou=users,dc=acme-corp,dc=net",
    "ldapGroupBaseDn": "ou=groups,dc=acme-corp,dc=net"
  },
  "storage": {
    "mode": "ocis",
    "filesystem": "xfs",
    "dataPath": "/srv/owncloud/data",
    "configPath": "/srv/owncloud/config"
  },
  "office": { "mode": "collabora", "deployment": "bundled" },
  "networking": {
    "domain": "cloud.acme-corp.net",
    "collaboraDomain": "office.acme-corp.net",
    "tls": { "mode": "acme", "email": "hostmaster@acme-corp.net" }
  },
  "mail": {
    "host": "smtp.acme-corp.net",
    "port": 587,
    "sender": "ownCloud <noreply@acme-corp.net>",
    "username": "owncloud",
    "authentication": "login",
    "insecure": false
  },
  "features": { "search": true, "clamav": true, "notifications": true, "monitoring": false },
  "security": { "basicAuth": false, "demoUsers": false },
  "updates": { "automaticSecurityPatches": false, "observationDelayHours": 24 }
}
