  "exclusions": [
    {
      "name": "ONLYOFFICE",
      "status": "deliberately-excluded",
      "rationale": "Only Collabora is supported as office integration per product rule",
      "policy_assertion": "ONLYOFFICE remains unavailable",
      "replacement": "Collabora"
    },
    {
      "name": "posixfs_direct",
      "status": "deliberately-excluded",
      "rationale": "Direct PosixFS modes remain unavailable per safety policy",
      "policy_assertion": "PosixFS, direct posix, xattr, GPFS-specific modes remain denied"
    },
    {
      "name": "cephfs",
      "status": "deliberately-excluded",
      "rationale": "CephFS remains unavailable until explicitly promoted",
      "policy_assertion": "CephFS excluded until explicit approval"
    },
    {
      "name": "eos",
      "status": "deliberately-excluded",
      "rationale": "EOS storage remains unavailable until explicitly promoted",
      "policy_assertion": "EOS excluded until explicit approval"
    },
    {
      "name": "debug_overlays",
      "status": "deliberately-excluded",
      "rationale": "Debug overlays are never production-selectable",
      "policy_assertion": "Debug overlays excluded from production deployments"
    }
  ],
  
  "drift_detection_rules": {
    "check_frequency": "daily",
    "repositories": [
      {
        "name": "owncloud/ocis",
        "branches": ["master", "feat/ocis-full-web-extensions-ai"],
        "check_overlays": true,
        "check_components": true
      }
    ],
    "actions": {
      "on_new_overlay": "create_issue",
      "on_removed_overlay": "create_issue",
      "on_changed_component": "create_issue",
      "on_missing_renderer": "fail_ci",
      "on_lost_policy_assertion": "fail_ci"
    }
  },
  
  "validation_rules": [
    "every_supported_component_must_have_renderer_for_all_promised_outputs",
    "every_supported_component_must_have_test_for_all_promised_outputs",
    "deliberate_exclusions_must_retain_policy_assertions",
    "changes_must_go_through_proper_review_process",
    "discovery_may_open_issue_but_never_auto_implement"
  ]
}