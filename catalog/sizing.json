    "minimumCpu": 2,
    "baseRamMiB": 1024,
    "ramMiBPerConcurrentUser": 100,
    "networkKbitPerConcurrentUser": 100,
    "usersPerCpuThreadCrossCheck": 10,
    "imageDiskGiB": 2,
    "evidence": "Collabora-maintained richdocumentscode requirements plus conservative container-image allowance"
  },
  "clamav": { "cpu": 1, "minimumRamMiB": 3072, "recommendedRamMiB": 4096, "diskGiB": 5 },
