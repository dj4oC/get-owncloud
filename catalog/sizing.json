{
  "version": "ocis-8.2.0-sizing-v3",
  "vocabulary": {
    "minimum": "Meets the component floor and is expected to start, but may degrade under real load.",
    "recommended": "Includes documented component floors and planning headroom; production still requires load testing.",
    "forbidden": ["guaranteed", "certified capacity"]
  },
  "defaults": {
    "peakConcurrentPercent": 10,
    "collaboraConcurrentPercent": 5,
    "spacesPerUser": 1.5,
    "annualGrowthPercent": 20,
    "headroomPercent": 30
  },
  "headroomBreakdown": {
    "backgroundTasksPercent": 15,
    "requestSpikesPercent": 10,
    "observabilityPercent": 5
  },
  "base": { "cpu": 2, "ramMiB": 4096, "diskGiB": 5 },
