  "aiSensitiveDataScanner": { "cpu": 1, "ramMiB": 2048, "diskGiB": 0 },
  "aiSmartCollectionsNav": { "cpu": 0.5, "ramMiB": 512, "diskGiB": 0 },
  "aiSmartFileTaggerQa": { "cpu": 1, "ramMiB": 1024, "diskGiB": 0 },
  "chatWithFile": { "cpu": 0.5, "ramMiB": 512, "diskGiB": 0 },
  "versionChangelog": { "cpu": 0.25, "ramMiB": 256, "diskGiB": 0 },
