{
  "version": "2026.08.22",
  "denyUnknownMaturity": true,
  "denyExperimental": true,
  "identity": {
    "embeddedMaximumUsers": 20
  },
  "office": {
    "allowed": ["none", "collabora"]
  },
  "storage": {
    "allowedModes": ["ocis", "s3ng", "nfs"],
    "allowedPosixFilesystems": ["ext4", "xfs", "btrfs", "zfs", "nfs"],
    "requiredNfsVersion": "4.2",
    "effectiveMountRequired": true,
    "denied": ["posixfs", "posix", "xattr", "gpfs", "cephfs", "eos", "smb", "cifs"]
  }
}
