{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://get.owncloud.com/schema/sizing-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["registeredUsers", "storedDataGiB"],
  "properties": {
    "registeredUsers": { "type": "integer", "minimum": 1, "x-input-complexity": "easy" },
    "storedDataGiB": { "type": "number", "minimum": 0, "x-input-complexity": "easy" },
    "annualGrowthPercent": { "type": "number", "minimum": 0, "x-input-complexity": "moderate" },
    "peakConcurrentUsers": { "type": "integer", "minimum": 1, "x-input-complexity": "advanced" },
    "collaboraConcurrentUsers": { "type": "integer", "minimum": 0, "x-input-complexity": "advanced" },
    "expectedSpaces": { "type": "integer", "minimum": 1, "x-input-complexity": "moderate" },
    "maximumPreviewMiB": { "type": "integer", "minimum": 1, "x-input-complexity": "moderate" },
    "highAvailability": { "type": "boolean", "x-input-complexity": "moderate" },
    "headroomPercent": { "type": "integer", "minimum": 30, "default": 30, "x-input-complexity": "advanced" }
  }
}
