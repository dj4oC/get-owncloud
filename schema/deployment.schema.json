{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://get.owncloud.com/schema/deployment.schema.json",
  "title": "ownCloud Infinite Scale deployment profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "purpose", "target", "workload", "identity", "storage", "office", "networking"],
  "properties": {
    "apiVersion": { "const": "get.owncloud.com/v1alpha1" },
    "purpose": { "enum": ["evaluation", "production"] },
    "maturity": { "enum": ["community-preview", "production"] },
    "ocisVersion": { "enum": ["8.2.0", "7.1.4"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "manager"],
      "properties": {
        "runtime": { "enum": ["docker", "podman", "kubernetes"] },
        "manager": { "enum": ["direct", "ansible", "argocd"] }
      }
    },
    "workload": { "$ref": "sizing-input.schema.json" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["embedded", "external-oidc"] },
        "issuer": { "type": "string", "format": "uri", "pattern": "^https://" },
        "clientId": { "type": "string", "minLength": 1 },
        "userClaim": { "type": "string", "default": "preferred_username" },
        "cs3Claim": { "type": "string", "default": "username" },
        "ldapUri": { "type": "string", "pattern": "^ldaps://" },
        "ldapBindDn": { "type": "string", "minLength": 1 },
        "ldapSecretRef": { "type": "string", "minLength": 1 },
        "ldapUserBaseDn": { "type": "string", "minLength": 1 },
        "ldapGroupBaseDn": { "type": "string", "minLength": 1 },
        "ldapUserIdAttribute": { "type": "string", "default": "ownclouduuid" },
        "ldapUserNameAttribute": { "type": "string", "default": "uid" },
        "ldapGroupIdAttribute": { "type": "string", "default": "ownclouduuid" },
        "ldapGroupNameAttribute": { "type": "string", "default": "cn" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "filesystem", "dataPath"],
      "properties": {
        "mode": { "enum": ["ocis", "s3ng"] },
        "filesystem": { "enum": ["ext4", "xfs", "btrfs", "zfs", "nfs"] },
        "dataPath": { "type": "string", "minLength": 1 },
        "configPath": { "type": "string", "minLength": 1 },
        "nfsVersion": { "const": "4.2" },
        "storageClassName": { "type": "string", "minLength": 1 },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "region", "bucket", "accessKeyReference", "secretKeyReference"],
          "properties": {
            "endpoint": { "type": "string", "format": "uri", "pattern": "^https://" },
            "region": { "type": "string", "minLength": 1 },
            "bucket": { "type": "string", "minLength": 1 },
            "accessKeyReference": { "type": "string", "minLength": 1 },
            "secretKeyReference": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "office": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "collabora"] },
        "deployment": { "enum": ["bundled", "external"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "networking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "tls"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "collaboraDomain": { "type": "string", "minLength": 1 },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "httpsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "ingressClassName": { "type": "string", "minLength": 1 },
        "tlsSecretName": { "type": "string", "minLength": 1 },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["acme", "evaluation-self-signed"] },
            "email": { "type": "string", "format": "email" },
            "caServer": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "mail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "sender": { "type": "string" },
        "username": { "type": "string" },
        "authentication": { "enum": ["none", "plain", "login"] },
        "insecure": { "type": "boolean" }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clamav": { "type": "boolean" },
        "search": { "type": "boolean" },
        "notifications": { "type": "boolean" },
        "aiProxy": {
          "oneOf": [
            { "type": "boolean" },
            { 
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "endpoint": { "type": "string", "format": "uri", "pattern": "^https://" },
                "apiKeySecretRef": { "type": "string" },
                "defaultTextModel": { "type": "string" },
                "visionModel": { "type": "string" },
                "forcedModel": { "type": "string" },
                "requestTimeout": { "type": "integer", "minimum": 1, "maximum": 300, "description": "Request timeout in seconds" },
                "tls": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "customCA": { "type": "boolean" },
                    "caSecretRef": { "type": "string" }
                  }
                },
                "outboundProxy": { "type": "string", "format": "uri" },
                "networkPolicy": { "type": "string" },
                "maxInputSize": { "type": "integer", "minimum": 1, "description": "Maximum input size in bytes" },
                "maxOutputSize": { "type": "integer", "minimum": 1, "description": "Maximum output size in bytes" },
                "maxConcurrency": { "type": "integer", "minimum": 1, "description": "Maximum concurrent requests" }
              }
            }
          ]
        },
        "aiDataInsightsSidebar": { "type": "boolean" },
        "aiDocSummary": { "type": "boolean" },
        "aiFolderBriefSidebar": { "type": "boolean" },
        "aiFolderReadmeGenerator": { "type": "boolean" },
        "aiImageAltTextSidebar": { "type": "boolean" },
        "aiLlmProxy": { "type": "boolean" },
        "aiMultiDocSynthesizer": { "type": "boolean" },
        "aiQuickDraftCreator": { "type": "boolean" },
        "aiSensitiveDataScanner": { "type": "boolean" },
        "aiSmartCollectionsNav": { "type": "boolean" },
        "aiSmartFileTaggerQa": { "type": "boolean" },
        "chatWithFile": { "type": "boolean" },
        "versionChangelog": { "type": "boolean" },
        "fileComments": { "type": "boolean" },
        "groupManagement": { "type": "boolean" },
        "ocisAppTokens": { "type": "boolean" },
        "vimNav": { "type": "boolean" },
        "monitoring": {
          "oneOf": [
            { "type": "boolean" },
            { 
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "metrics": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "endpoint": { "type": "string", "format": "uri" },
                    "authentication": { "type": "boolean" }
                  }
                },
                "opentelemetry": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "endpoint": { "type": "string", "format": "uri" },
                    "protocol": { "enum": ["grpc", "http"] },
                    "tls": { "type": "boolean" },
                    "caSecretRef": { "type": "string" }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basicAuth": { "type": "boolean" },
        "demoUsers": { "type": "boolean" }
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automaticSecurityPatches": { "type": "boolean" },
        "observationDelayHours": { "type": "integer", "minimum": 24 },
        "backupRecipient": {
          "type": "string",
          "pattern": "^(age1|ssh-ed25519 )",
          "description": "Operator-controlled public recipient used to encrypt automatic pre-update backups"
        }
      }
    },
    "demoContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "optInRequired": { "type": "boolean" },
        "destructiveWarning": { "type": "boolean" },
        "licenses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sampleFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "license": { "type": "string" },
              "origin": { "type": "string" },
              "size": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "resetPath": { "type": "string" }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "ramMiB", "diskGiB"],
      "properties": {
        "cpu": { "type": "integer", "minimum": 1 },
        "ramMiB": { "type": "integer", "minimum": 1 },
        "diskGiB": { "type": "number", "minimum": 0 }
      }
    }
  }
}
