{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://get.owncloud.com/schema/update-policy.schema.json",
  "title": "get-owncloud automatic update policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "automaticSecurityUpdates",
    "observationDelayHours",
    "eligible",
    "manualOnly",
    "breakingAutomatic"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "automaticSecurityUpdates": { "type": "boolean" },
    "observationDelayHours": { "type": "integer", "minimum": 24 },
    "eligible": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "same-minor-patch",
          "security-classified",
          "no-migration",
          "backup-ready",
          "health-check-ready",
          "rollback-safe"
        ]
      }
    },
    "manualOnly": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["minor", "major", "breaking", "migration", "storage-schema", "idm-schema", "unknown"]
      }
    },
    "breakingAutomatic": { "const": false }
  }
}
