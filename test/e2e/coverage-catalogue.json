        { "value": "ldap://ldap.corp.example:389", "description": "valid LDAP", "testFile": "identity.spec.mjs", "testFunction": "testLdapUriValidLdap" },
        { "value": "", "description": "missing", "testFile": "identity.spec.mjs", "testFunction": "testLdapUriMissing" },
        { "value": "invalid-uri", "description": "malformed", "testFile": "identity.spec.mjs", "testFunction": "testLdapUriMalformed" }
      ],
      "requiredWhen": "identityMode === external-oidc"
    },
    "ldapBindDn": {
      "description": "LDAP bind DN",
      "type": "text",
      "testValues": [
        { "value": "uid=ocis,ou=system,dc=corp,dc=example", "description": "valid", "testFile": "identity.spec.mjs", "testFunction": "testLdapBindDnValid" },
        { "value": "", "description": "missing", "testFile": "identity.spec.mjs", "testFunction": "testLdapBindDnMissing" }
      ],
      "requiredWhen": "identityMode === external-oidc"
    },
    "ldapUserBaseDn": {
      "description": "LDAP user base DN",
      "type": "text",
      "testValues": [
        { "value": "ou=users,dc=corp,dc=example", "description": "valid", "testFile": "identity.spec.mjs", "testFunction": "testLdapUserBaseDnValid" },
        { "value": "", "description": "missing", "testFile": "identity.spec.mjs", "testFunction": "testLdapUserBaseDnMissing" }
      ],
      "requiredWhen": "identityMode === external-oidc"
    },
    "ldapGroupBaseDn": {
      "description": "LDAP group base DN",
      "type": "text",
      "testValues": [
        { "value": "ou=groups,dc=corp,dc=example", "description": "valid", "testFile": "identity.spec.mjs", "testFunction": "testLdapGroupBaseDnValid" },
        { "value": "", "description": "missing", "testFile": "identity.spec.mjs", "testFunction": "testLdapGroupBaseDnMissing" }
      ],
      "requiredWhen": "identityMode === external-oidc"
