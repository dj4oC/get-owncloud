        { "value": "localhost", "description": "reserved domain", "testFile": "networking.spec.mjs", "testFunction": "testDomainReserved" },
        { "value": "test", "description": "invalid", "testFile": "networking.spec.mjs", "testFunction": "testDomainInvalid" }
