    "ldapBindPassword": {
      "description": "LDAP bind password",
      "type": "password",
      "testValues": [
        { "value": "local-test-bind-password", "description": "valid", "testFile": "identity.spec.mjs", "testFunction": "testLdapBindPasswordValid" },
        { "value": "", "description": "missing", "testFile": "identity.spec.mjs", "testFunction": "testLdapBindPasswordMissing" }
      ],
      "requiredWhen": "identityMode === external-oidc",
      "securityNote": "Must never appear in page, profile download, console or error messages. Only references allowed."
    },
    "storageMode": {
      "description": "Storage driver",
      "type": "select",
      "options": [
        { "value": "ocis", "testFile": "storage.spec.mjs", "testFunction": "testStorageModeOcis" },
        { "value": "s3ng", "testFile": "storage.spec.mjs", "testFunction": "testStorageModeS3ng" }
      ],
      "forbiddenValues": ["posixfs", "posix", "xattr", "GPFS", "CephFS", "EOS"],
      "conditionalBehavior": {
        "s3ng": {
          "requiresFields": ["s3Endpoint", "s3Region", "s3Bucket", "s3AccessKey", "s3SecretKey"]
        }
      }
    },
    "filesystem": {
      "description": "Filesystem type",
      "type": "select",
      "options": [
        { "value": "ext4", "testFile": "storage.spec.mjs", "testFunction": "testFilesystemExt4" },
        { "value": "xfs", "testFile": "storage.spec.mjs", "testFunction": "testFilesystemXfs" },
        { "value": "btrfs", "testFile": "storage.spec.mjs", "testFunction": "testFilesystemBtrfs" },
        { "value": "zfs", "testFile": "storage.spec.mjs", "testFunction": "testFilesystemZfs" },
        { "value": "nfs", "testFile": "storage.spec.mjs", "testFunction": "testFilesystemNfs" }
      ],
      "conditionalBehavior": {
        "nfs": {
          "requiresVersion": "4.2",
          "warning": "NFSv4.2 required"
        }
      }
    },
    "dataPath": {
      "description": "Data path",
      "type": "text",
      "testValues": [
        { "value": "./data/data", "description": "default", "testFile": "storage.spec.mjs", "testFunction": "testDataPathDefault" },
        { "value": "/srv/owncloud/data", "description": "custom", "testFile": "storage.spec.mjs", "testFunction": "testDataPathCustom" }
      ]
    },
    "configPath": {
      "description": "Configuration path",
      "type": "text",
      "testValues": [
        { "value": "./data/config", "description": "default", "testFile": "storage.spec.mjs", "testFunction": "testConfigPathDefault" },
        { "value": "/srv/owncloud/config", "description": "custom", "testFile": "storage.spec.mjs", "testFunction": "testConfigPathCustom" }
      ]
    },
    "officeMode": {
      "description": "Office integration mode",
      "type": "select",
      "options": [
        { "value": "none", "testFile": "collabora.spec.mjs", "testFunction": "testOfficeModeNone" },
        { "value": "bundled", "testFile": "collabora.spec.mjs", "testFunction": "testOfficeModeBundled" },
        { "value": "external", "testFile": "collabora.spec.mjs", "testFunction": "testOfficeModeExternal" }
      ],
      "forbiddenValues": ["ONLYOFFICE", "unknown"],
      "conditionalBehavior": {
        "bundled": {
          "supportedOn": ["docker", "podman"],
          "requiresFields": ["bundledDomain", "bundledAdminPassword"]
        },
        "external": {
          "supportedOn": ["docker", "podman", "kubernetes"],
          "requiresFields": ["externalCollaboraUrl"]
        },
        "none": {
          "supportedOn": ["docker", "podman", "kubernetes"]
        },
        "kubernetes": {
          "forces": "external",
          "requiresHttps": true
        }
      }
    },
    "bundledDomain": {
      "description": "Bundled Collabora domain",
      "type": "text",
      "testValues": [
        { "value": "office.localhost", "description": "valid", "testFile": "collabora.spec.mjs", "testFunction": "testBundledDomainValid" }
      ],
      "requiredWhen": "officeMode === bundled"
    },
    "bundledAdminPassword": {
      "description": "Bundled Collabora admin password",
      "type": "password",
      "testValues": [
        { "value": "admin-password-test", "description": "valid", "testFile": "collabora.spec.mjs", "testFunction": "testBundledAdminPasswordValid" }
      ],
      "requiredWhen": "officeMode === bundled",
      "securityNote": "Must be handled securely"
    },
    "externalCollaboraUrl": {
      "description": "External Collabora URL",
      "type": "text",
      "testValues": [
