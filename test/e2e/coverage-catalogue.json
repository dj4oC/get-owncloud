{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "generatedAt": "2026-09-05T00:00:00Z",
  "description": "Machine-readable Playwright E2E coverage catalogue for get-ownCloud configurator. This catalogue must be kept in sync with all UI options and enum values.",
  "coverageRequirements": {
    "directCoverage": "Every individual control value must have at least one direct test",
    "pairwiseCoverage": "Valid interacting options must have pairwise tests",
    "highRiskJourneys": "High-risk combinations must have focused multi-option tests",
    "completenessGuard": "Adding an option without E2E coverage must fail CI"
  },
  "controls": {
    "bootstrapCommandPicker": {
      "description": "Bootstrap command selection",
      "type": "select",
      "options": [
        { "value": "docker", "testFile": "bootstrap.spec.mjs", "testFunction": "testDockerBootstrap" },
        { "value": "podman", "testFile": "bootstrap.spec.mjs", "testFunction": "testPodmanBootstrap" },
        { "value": "kubernetes", "testFile": "bootstrap.spec.mjs", "testFunction": "testKubernetesBootstrap" },
        { "value": "ansible", "testFile": "bootstrap.spec.mjs", "testFunction": "testAnsibleBootstrap" }
      ],
      "validCombinations": [
        ["docker", "direct"],
        ["podman", "direct"],
        ["podman", "ansible"],
        ["kubernetes", "helm"],
        ["kubernetes", "argocd"]
      ],
      "pairwiseCoverageRequired": true
    },
    "purpose": {
      "description": "Deployment purpose",
      "type": "select",
      "options": [
        { "value": "evaluation", "testFile": "deployment-target.spec.mjs", "testFunction": "testPurposeEvaluation" },
        { "value": "production", "testFile": "deployment-target.spec.mjs", "testFunction": "testPurposeProduction" }
      ],
      "pairwiseWith": ["runtime", "manager", "maturity"],
      "conditionalBehavior": {
        "production": {
          "disabledOptions": ["evaluationSelfSignedTls"],
          "forcedPorts": { "http": 80, "https": 443 },
          "maturity": "production"
        },
        "evaluation": {
          "maturity": "community-preview",
          "basicAuth": true
        }
      }
    },
    "runtime": {
      "description": "Target runtime",
      "type": "select",
      "options": [
        { "value": "docker", "testFile": "deployment-target.spec.mjs", "testFunction": "testRuntimeDocker" },
        { "value": "podman", "testFile": "deployment-target.spec.mjs", "testFunction": "testRuntimePodman" },
        { "value": "kubernetes", "testFile": "deployment-target.spec.mjs", "testFunction": "testRuntimeKubernetes" }
      ],
      "pairwiseWith": ["purpose", "manager"],
      "conditionalBehavior": {
        "kubernetes": {
          "forcedManager": ["helm", "argocd"],
          "ocisVersion": "7.1.4",
          "forcesExternalCollabora": true
        },
        "docker": {
          "supportedManager": ["direct", "ansible"],
          "ocisVersion": "8.2.0"
        },
        "podman": {
          "supportedManager": ["direct", "ansible"],
          "ocisVersion": "8.2.0",
          "maturityNote": "Podman is runnable Community Preview until its full parity matrix passes."
        }
      }
    },
    "manager": {
      "description": "Configuration manager",
      "type": "select",
      "options": [
        { "value": "direct", "testFile": "deployment-target.spec.mjs", "testFunction": "testManagerDirect" },
        { "value": "ansible", "testFile": "deployment-target.spec.mjs", "testFunction": "testManagerAnsible" },
        { "value": "helm", "testFile": "deployment-target.spec.mjs", "testFunction": "testManagerHelm" },
        { "value": "argocd", "testFile": "deployment-target.spec.mjs", "testFunction": "testManagerArgocd" }
      ],
      "pairwiseWith": ["runtime", "purpose"],
      "validCombinations": [
        ["docker", "direct"],
        ["docker", "ansible"],
        ["podman", "direct"],
        ["podman", "ansible"],
        ["kubernetes", "helm"],
        ["kubernetes", "argocd"]
      ],
      "invalidCombinations": [
        ["kubernetes", "direct"],
        ["kubernetes", "ansible"],
        ["docker", "helm"],
        ["docker", "argocd"],
        ["podman", "helm"],
        ["podman", "argocd"]
      ]
    },
    "registeredUsers": {
      "description": "Number of registered users",
      "type": "number",
      "testValues": [
        { "value": 0, "description": "minimum", "testFile": "workload.spec.mjs", "testFunction": "testRegisteredUsersMinimum" },
        { "value": 20, "description": "boundary for embedded identity", "testFile": "workload.spec.mjs", "testFunction": "testRegisteredUsers20" },
        { "value": 21, "description": "boundary invalid for embedded", "testFile": "workload.spec.mjs", "testFunction": "testRegisteredUsers21" },
        { "value": 100, "description": "representative", "testFile": "workload.spec.mjs", "testFunction": "testRegisteredUsers100" },
        { "value": 1000, "description": "large", "testFile": "workload.spec.mjs", "testFunction": "testRegisteredUsersLarge" },
        { "value": "", "description": "invalid/empty", "testFile": "workload.spec.mjs", "testFunction": "testRegisteredUsersInvalid" }
      ],
      "conditionalBehavior": {
        "embedded": {
          "maxUsers": 20,
          "autoSwitch": true
        }
      }
    },
    "storedDataGiB": {
      "description": "Stored data in GiB",
      "type": "number",
      "testValues": [
        { "value": 0, "description": "zero", "testFile": "workload.spec.mjs", "testFunction": "testStoredDataZero" },
        { "value": 50, "description": "normal", "testFile": "workload.spec.mjs", "testFunction": "testStoredDataNormal" },
        { "value": 1000, "description": "large", "testFile": "workload.spec.mjs", "testFunction": "testStoredDataLarge" }
      ]
    },
    "annualGrowthPercent": {
      "description": "Annual growth percentage",
      "type": "number",
      "testValues": [
        { "value": 0, "description": "zero", "testFile": "workload.spec.mjs", "testFunction": "testAnnualGrowthZero" },
        { "value": 20, "description": "normal", "testFile": "workload.spec.mjs", "testFunction": "testAnnualGrowthNormal" },
        { "value": 50, "description": "boundary", "testFile": "workload.spec.mjs", "testFunction": "testAnnualGrowthBoundary" },
        { "value": "", "description": "invalid", "testFile": "workload.spec.mjs", "testFunction": "testAnnualGrowthInvalid" }
      ]
    },
    "systemCpu": {
      "description": "System CPU cores",
      "type": "number",
      "optional": true,
      "testValues": [
        { "value": "", "description": "absent", "testFile": "workload.spec.mjs", "testFunction": "testSystemCpuAbsent" },
        { "value": 2, "description": "below recommendation", "testFile": "workload.spec.mjs", "testFunction": "testSystemCpuBelow" },
        { "value": 4, "description": "at recommendation", "testFile": "workload.spec.mjs", "testFunction": "testSystemCpuAtRecommendation" },
        { "value": 8, "description": "above recommendation", "testFile": "workload.spec.mjs", "testFunction": "testSystemCpuAbove" }
      ]
    },
    "systemRamGiB": {
      "description": "System RAM in GiB",
      "type": "number",
      "optional": true,
      "testValues": [
        { "value": "", "description": "absent", "testFile": "workload.spec.mjs", "testFunction": "testSystemRamAbsent" },
        { "value": 4, "description": "below recommendation", "testFile": "workload.spec.mjs", "testFunction": "testSystemRamBelow" },
        { "value": 8, "description": "at recommendation", "testFile": "workload.spec.mjs", "testFunction": "testSystemRamAtRecommendation" },
        { "value": 16, "description": "above recommendation", "testFile": "workload.spec.mjs", "testFunction": "testSystemRamAbove" }
      ]
    },
    "systemDiskGiB": {
      "description": "System disk in GiB",
      "type": "number",
      "optional": true,
      "testValues": [
        { "value": "", "description": "absent", "testFile": "workload.spec.mjs", "testFunction": "testSystemDiskAbsent" },
        { "value": 10, "description": "below recommendation", "testFile": "workload.spec.mjs", "testFunction": "testSystemDiskBelow" },
        { "value": 50, "description": "at recommendation", "testFile": "workload.spec.mjs", "testFunction": "testSystemDiskAtRecommendation" },
        { "value": 100, "description": "above recommendation", "testFile": "workload.spec.mjs", "testFunction": "testSystemDiskAbove" }
      ]
    },
    "identityMode": {
      "description": "Identity provider mode",
      "type": "select",
      "options": [
        { "value": "embedded", "testFile": "identity.spec.mjs", "testFunction": "testIdentityEmbedded" },
        { "value": "external-oidc", "testFile": "identity.spec.mjs", "testFunction": "testIdentityExternalOidc" }
      ],
      "conditionalBehavior": {
        "embedded": {
          "maxUsers": 20,
          "autoSwitchToExternalOidc": true
        },
        "external-oidc": {
          "requiresFields": ["oidcIssuer", "oidcClientId", "ldapUri", "ldapBindDn", "ldapUserBaseDn", "ldapGroupBaseDn", "ldapBindPassword"]
        }
      }
    },
    "oidcIssuer": {
      "description": "OIDC issuer URL",
      "type": "text",
      "testValues": [
        { "value": "https://id.corp.example/realms/owncloud", "description": "valid", "testFile": "identity.spec.mjs", "testFunction": "testOidcIssuerValid" },
        { "value": "", "description": "missing", "testFile": "identity.spec.mjs", "testFunction": "testOidcIssuerMissing" },
        { "value": "not-a-url", "description": "malformed", "testFile": "identity.spec.mjs", "testFunction": "testOidcIssuerMalformed" }
      ],
      "requiredWhen": "identityMode === external-oidc"
    },
    "oidcClientId": {
      "description": "OIDC client ID",
      "type": "text",
      "testValues": [
        { "value": "owncloud-web", "description": "valid", "testFile": "identity.spec.mjs", "testFunction": "testOidcClientIdValid" },
        { "value": "", "description": "missing", "testFile": "identity.spec.mjs", "testFunction": "testOidcClientIdMissing" }
