        { "value": 10, "description": "explicit", "testFile": "collabora.spec.mjs", "testFunction": "testCollaboraConcurrentUsersExplicit" }
      ]
    },
    "tlsMode": {
      "description": "TLS mode",
      "type": "select",
      "options": [
        { "value": "evaluation-self-signed", "testFile": "networking.spec.mjs", "testFunction": "testTlsModeEvaluationSelfSigned" },
        { "value": "acme", "testFile": "networking.spec.mjs", "testFunction": "testTlsModeAcme" }
