{
  "name": "get-owncloud",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "One profile and one page for safe ownCloud Infinite Scale deployment generation.",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/**/*.test.mjs",
