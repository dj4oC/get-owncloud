  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  },
  "license": "Apache-2.0"
}
